{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "compare-cities",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Durable, global cache for finished city lookups and transit (see src/lib/server/upstream.ts).
	"kv_namespaces": [{ "binding": "CITY_CACHE", "id": "e3ae66515ce247adbee5fdab3b52b06d" }],
	// Per-IP limits so nobody can hammer the free upstream services through us.
	"ratelimits": [
		{ "name": "API_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RENDER_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": false
		}
	}
}
