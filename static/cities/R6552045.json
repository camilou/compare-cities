, as is Iguazu Falls.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Centro_ciudad_del_este.jpg/330px-Centro_ciudad_del_este.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Ciudad_del_Este"},"twins":[],"climate":{"temp":[27.6,27.5,26.7,24,19.5,17.8,17.2,19.2,21.7,24.3,25.4,27.3],"rain":[147,129,117,124,163,108,85,70,121,211,159,179],"cloud":[65,64,54,51,55,57,52,48,53,60,57,67]},"land":true}