":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Museu_de_Arte_Contempor%C3%A2nea_by_Diego_Baravelli.jpg/330px-Museu_de_Arte_Contempor%C3%A2nea_by_Diego_Baravelli.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Niter%C3%B3i"},"twins":["Q8678","Q28271"],"climate":{"temp":[26.2,26.4,25.9,24.8,22.8,22,21.5,21.8,22.5,23.5,24,25.2],"rain":[208,152,173,101,71,49,45,42,69,108,220,232],"cloud":[71,62,66,56,56,49,45,45,57,70,79,75]},"land":true}