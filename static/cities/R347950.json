[2.22698,41.40841],[2.22836,41.40842],[2.22786,41.40961],[2.2275,41.40941],[2.22698,41.40841]]]]},"wikidata":"Q1492","facts":{"population":{"value":1731649,"year":2025},"elevation":9,"officialArea":101.3,"website":"https://barcelona.cat","mayor":"Jaume Collboni Cuadrado"},"summary":{"extract":"Barcelona is a city on the northeastern coast of Spain. It is the capital and largest city of the autonomous community of Catalonia, as well as the second-most populous municipality of Spain after Madrid. With a population of 1.7 million within city limits, its urban area extends to numerous neighbouring municipalities within the province of Barcelona and is home to around 5.7 million people, making it the fifth most populous urban area of the European Union after Paris, the Ruhr area, Madrid, and Milan. It is one of the largest metropolises on the Mediterranean Sea, located on the coast between the mouths of the rivers Llobregat and Besòs, and bounded to the west by the Serra de Collserola mountain range.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Evening_light_over_Barcelona.jpg/330px-Evening_light_over_Barcelona.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Barcelona"},"twins":["Q100","Q85","Q42053","Q6441","Q6506","Q47492","Q1761","Q5123","Q174","Q340","Q365","Q656","Q1486","Q1524","Q1563","Q1792","Q3561","Q6730","Q8678","Q8686","Q8717","Q11194","Q12892","Q16520","Q19689","Q33935","Q33986","Q34820","Q42495","Q48278","Q48320","Q1335","Q891","Q406","Q1119894","Q42635","Q612","Q80985","Q1854","Q214173","Q52535","Q62","Q81033","Q1899","Q2900"],"climate":{"temp":[9.3,10,12.7,15.6,19.3,24,26.6,26.5,22.9,19,13.5,10],"rain":[34,32,43,50,49,27,28,41,59,70,54,31],"cloud":[69,66,63,62,58,47,38,44,56,65,68,68]},"land":true,"green":{"parksPct":26.3,"greenPct":29.1,"parksKm2":26.7},"transit":{"metroKm":214,"buswayKm":1,"bikeKm":244,"stations":111,"lines":14}}