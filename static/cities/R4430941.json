gzhou, as \"paradise on earth,\" a reputation that endures today as the city blends its timeless canals, whitewashed lanes, and scholarly heritage with modern industries. Suzhou is part of the Yangtze Delta megalopolis.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/%E4%B8%9C%E6%96%B9%E4%B9%8B%E9%97%A81.jpg/330px-%E4%B8%9C%E6%96%B9%E4%B9%8B%E9%97%A81.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Suzhou"},"twins":["Q641","Q2132","Q817965","Q191130","Q6106","Q191078","Q42140","Q633996","Q1773","Q217156","Q1289","Q47887","Q240489","Q26234","Q3834","Q2397257","Q166183","Q40269","Q16568","Q429864","Q42150","Q802","Q1899","Q157835","Q1782552","Q3915","Q44827","Q184345","Q42126","Q1204975","Q8775","Q1087776","Q1206740","Q1663450","Q1303631","Q460835","Q694370","Q15720","Q318314","Q838791","Q12193","Q983845","Q986336","Q501891","Q200731","Q34378","Q432027","Q208893","Q170616","Q42160","Q117604","Q189128"],"climate":{"temp":[3.2,5.4,9.7,15.5,21,24.9,28.4,28.1,23.8,18.3,12.3,5.3],"rain":[60,71,76,95,92,179,188,159,116,66,64,43],"cloud":[65,68,65,66,71,79,71,66,63,57,57,56]}}