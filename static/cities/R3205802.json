s and aquaculture ponds are found on the outskirts of the city. Sihui and the southern districts of the prefecture are considered part of the Pearl River Delta.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/13/%E4%B8%83%E6%98%9F%E5%B2%A9%E5%BE%80%E5%B8%82%E5%8C%BA%E6%96%B9%E5%90%91%E8%BF%9C%E7%9C%BA.JPG/330px-%E4%B8%83%E6%98%9F%E5%B2%A9%E5%BE%80%E5%B8%82%E5%8C%BA%E6%96%B9%E5%90%91%E8%BF%9C%E7%9C%BA.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Zhaoqing"},"twins":["Q984534","Q184579","Q432621"],"climate":{"temp":[13.8,16.8,20.2,23.9,26.6,27.9,28.4,28.4,26.9,23.6,19.7,14.6],"rain":[54,44,100,154,291,310,213,241,178,60,49,34],"cloud":[68,78,84,84,83,84,76,75,65,50,55,54]},"land":true}