/22/%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D1%8F%D1%80%D1%81%D0%BA_%28%D0%BD%D0%BE%D1%87%D0%BD%D0%BE%D0%B9%29.jpg/330px-%D0%9A%D1%80%D0%B0%D1%81%D0%BD%D0%BE%D1%8F%D1%80%D1%81%D0%BA_%28%D0%BD%D0%BE%D1%87%D0%BD%D0%BE%D0%B9%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Krasnoyarsk"},"twins":["Q6231","Q898","Q92161","Q304848","Q48256","Q42956","Q349983","Q6576","Q936510","Q1829","Q900","Q6049","Q1094915","Q154835","Q649","Q175517","Q883","Q1019805","Q205922","Q5753","Q656","Q193586","Q976","Q5470","Q23430","Q59096","Q25797","Q182521","Q463165"],"climate":{"temp":[-19,-15.8,-6.7,2.6,9.9,18.3,20,17.4,10.1,1.5,-8.3,-16.5],"rain":[18,18,24,34,62,70,78,73,56,43,36,29],"cloud":[65,66,70,68,71,62,65,63,72,82,80,74]},"land":true}