g/wikipedia/commons/thumb/8/82/Antonio_Vaz_island_-_Recife%2C_Pernambuco%2C_Brazil_%28cropped%29.jpg/330px-Antonio_Vaz_island_-_Recife%2C_Pernambuco%2C_Brazil_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Recife"},"twins":["Q16572","Q647543","Q727","Q12191","Q14773","Q36433","Q213242","Q30002"],"climate":{"temp":[27.5,27.7,27.8,27.4,26.6,25.5,24.7,24.5,25.1,26.1,27,27.5],"rain":[85,94,124,170,203,261,206,115,59,36,24,38],"cloud":[49,51,48,47,48,50,46,40,37,39,38,42]},"land":true}