ornia gold rush.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Lake_Merritt_2022-06-16.png/330px-Lake_Merritt_2022-06-16.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Oakland%2C_California"},"twins":["Q117040","Q25444","Q6761","Q26600","Q156658","Q243293","Q74881","Q602783","Q170525","Q25282","Q23430","Q464699","Q105037"],"climate":{"temp":[9.6,10.6,11.7,12.5,14.2,16.3,17.1,17.6,17.9,16.1,12.6,9.9],"rain":[100,102,82,42,18,6,1,1,4,29,62,138],"cloud":[58,58,58,53,51,44,56,57,46,44,50,59]},"land":true}