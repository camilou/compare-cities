/3/32/Chennai_Central.jpg/330px-Chennai_Central.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Chennai"},"twins":["Q914","Q11725","Q975","Q16554","Q1865","Q41278","Q2795","Q1794"],"climate":{"temp":[24.4,25.9,28.7,30.8,31.8,30.9,30,29.3,28.6,27.7,26,24.7],"rain":[16,6,15,26,55,68,108,132,145,264,292,126],"cloud":[36,29,30,37,54,77,83,81,72,63,61,51]},"land":true}