a.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Hamburg"},"twins":["Q656","Q23482","Q8686","Q1731","Q35765","Q208151","Q1085","Q1297","Q1960","Q6506","Q37100","Q160687","Q1829","Q174","Q1899"],"climate":{"temp":[0.7,1.3,4.1,8.7,12.9,16.3,18.3,18,14.4,9.8,5.3,2],"rain":[70,55,50,40,58,71,84,71,58,63,63,71],"cloud":[81,77,71,61,67,68,67,66,66,71,78,82]}}