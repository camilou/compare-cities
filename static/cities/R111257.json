ons/thumb/b/b9/Downtown_Phoenix_Aerial_Looking_Northeast.jpg/330px-Downtown_Phoenix_Aerial_Looking_Northeast.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Phoenix%2C_Arizona"},"twins":["Q46400","Q192807","Q36312","Q30002","Q189138","Q209801","Q1867","Q1085","Q209128","Q1289","Q1903","Q612"]}