0 sq mi).","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/67/%E4%B8%9C%E8%8E%9E%E5%B8%82%2C_%E4%B8%AD%E5%9B%BD_Jul_18%2C_2019_15-38-32.jpeg/330px-%E4%B8%9C%E8%8E%9E%E5%B8%82%2C_%E4%B8%AD%E5%9B%BD_Jul_18%2C_2019_15-38-32.jpeg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Dongguan"},"twins":["Q2107"],"climate":{"temp":[14.7,17.3,20.3,23.8,26.7,28,28.6,28.5,27.4,24.3,20.6,15.5],"rain":[45,38,91,142,278,325,205,232,164,50,37,28],"cloud":[63,75,82,83,83,84,76,75,63,49,53,52]},"land":true}