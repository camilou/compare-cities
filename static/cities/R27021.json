ikipedia.org/wiki/Kiel"},"twins":["Q125080","Q12193","Q6225","Q385","Q1770","Q4065","Q1829","Q5647","Q160450","Q80561","Q3324799","Q62","Q25319"],"climate":{"temp":[1.3,1.4,3.4,7.3,11.9,15.4,17.8,17.7,14.7,10.5,6.2,2.8],"rain":[67,54,48,37,53,70,78,83,62,70,66,70],"cloud":[84,81,74,62,63,66,67,67,67,73,80,84]},"land":true}