5.70369]]],[[[12.63697,55.6628],[12.64007,55.65937],[12.64027,55.65779],[12.64256,55.65744],[12.64669,55.6544],[12.64285,55.65089],[12.64711,55.64831],[12.6491,55.64839],[12.6481,55.6521],[12.65,55.65436],[12.65207,55.6546],[12.64781,55.65582],[12.64173,55.66036],[12.63892,55.66446],[12.63958,55.6655],[12.63697,55.6628]]],[[[12.66355,55.72075],[12.66391,55.71966],[12.6655,55.71906],[12.66372,55.72054],[12.66748,55.71939],[12.66594,55.71915],[12.66602,55.71911],[12.66728,55.71928],[12.6678,55.71945],[12.66822,55.72045],[12.66591,55.72165],[12.66355,55.72075]]],[[[12.72895,55.70378],[12.73353,55.70267],[12.73424,55.70318],[12.73142,55.70416],[12.72895,55.70378]]]]},"wikidata":"Q504125","facts":{"population":{"value":633021,"year":2019},"elevation":6,"officialArea":86.7,"website":"http://www.kk.dk/","mayor":"Sisse Marie Welling"},"summary":{"extract":"Copenhagen Municipality, also known in English as the Municipality of Copenhagen, located in the Capital Region of Denmark, is the largest of the four municipalities that constitute the City of Copenhagen, the other three being Dragør, Frederiksberg, and Tårnby. The Municipality of Copenhagen constitutes the historic city center and the majority of its landmarks. It is the most populous in the country with a population of 673,575 inhabitants, and covers 90.9 km2 (35.1 sq mi). Copenhagen Municipality is located on the islands of Zealand and Amager, and totally surrounds Frederiksberg Municipality on all sides. The strait of Øresund lies to the east. The city of Copenhagen has grown far beyond the municipal boundaries from 1901, when Frederiksberg Municipality was made an enclave within Copenhagen Municipality. Frederiksberg has the highest population density of the municipalities of Denmark.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Copenhagen_aerial_view_by_night.jpg/330px-Copenhagen_aerial_view_by_night.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Copenhagen_Municipality"},"twins":[]}