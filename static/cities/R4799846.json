rth from ashes and destruction.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Skyline_of_Fukui_City02.jpg/330px-Skyline_of_Fukui_City02.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Fukui_(city)"},"twins":["Q138338","Q494723","Q4970","Q199889","Q20714","Q847569"],"climate":{"temp":[3.8,4.3,7.2,12.4,17.7,22,25.9,27.1,23.3,17.5,12,6.7],"rain":[198,132,141,137,137,162,249,162,208,169,160,237],"cloud":[91,86,80,75,75,82,81,72,77,73,78,88]}}