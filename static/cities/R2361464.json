ters from the Mediterranean Sea.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/084place_carnot.JPG/330px-084place_carnot.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Sidi_Bel_Abb%C3%A8s"},"twins":[],"climate":{"temp":[9.6,10.5,13.4,16.3,20.1,24.9,28.8,28.6,24.1,20,13.7,10.6],"rain":[67,48,52,68,45,14,6,17,38,56,76,61],"cloud":[50,48,47,47,41,30,28,27,37,38,47,48]},"land":true}