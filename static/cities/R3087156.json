aign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Astana"},"twins":["Q3640","Q649","Q1342","Q1899","Q656","Q3805","Q11194","Q1773","Q1792","Q270","Q994","Q1858","Q8684","Q1861","Q900","Q1461","Q956","Q618045","Q9361","Q613","Q3630","Q189134","Q214173","Q216","Q1953"]}