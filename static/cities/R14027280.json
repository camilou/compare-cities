sbane is Brisbanite.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Brisbane_CBD_seen_from_Kangaroo_Point%2C_2024%2C_01_%282%29.jpg/330px-Brisbane_CBD_seen_from_Kangaroo_Point%2C_2024%2C_01_%282%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Brisbane"},"twins":["Q612","Q48320","Q47916","Q37100","Q15174","Q11025","Q181557","Q20921","Q11725","Q1519","Q1861","Q758634","Q33959","Q10395"],"climate":{"temp":[25.8,25.5,24.4,22.3,19.4,17.3,16.4,17.2,19.7,21.7,23.5,24.9],"rain":[140,156,136,83,73,88,38,45,38,81,92,130],"cloud":[54,53,54,46,45,49,39,32,34,44,48,54]}}