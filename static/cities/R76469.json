e only large city in France to have a national park within city limits.","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/Notre-Dame_de_la_Garde_aerial_view_2020.jpeg/330px-Notre-Dame_de_la_Garde_aerial_view_2020.jpeg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Marseille"},"twins":["Q1515","Q12892","Q1748","Q3718","Q1449","Q4093","Q41621","Q1055","Q48320","Q101625","Q1874","Q58976","Q8686","Q1953","Q2634","Q1792","Q1046653","Q19689","Q3572","Q3820","Q11462","Q17151","Q192807","Q18288152","Q28870916","Q1899"],"climate":{"temp":[7.3,7.8,10.9,14.5,18.6,23.8,26.7,26.1,21.6,17.1,11.8,8.1],"rain":[48,38,40,47,47,29,13,21,50,75,94,54],"cloud":[59,54,53,52,51,39,28,33,41,54,58,56]}}