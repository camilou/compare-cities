ipedia.org&utm_campaign=api&utm_content=thumbnail","url":"https://en.wikipedia.org/wiki/Saint_Petersburg"},"twins":["Q1792","Q180522","Q87","Q35493","Q12892","Q9248","Q1861","Q1492","Q270","Q5776","Q1563","Q1055","Q13298","Q80021","Q1731","Q9365","Q1953","Q1435","Q42053","Q2145","Q5465","Q1899","Q35381","Q192155","Q25409","Q456","Q65","Q36036","Q18125","Q1010","Q1919098","Q190583","Q2280","Q1335","Q1156","Q41572","Q1874","Q25319","Q35765","Q47282","Q58976","Q459","Q1085","Q16520","Q8678","Q1773","Q34370","Q49236","Q117040","Q7525","Q406","Q506250","Q1770","Q40840","Q994","Q20927","Q41621","Q1963","Q42308","Q1757","Q1854","Q30002","Q8686","Q23436","Q641","Q31487","Q72818","Q4115712","Q79808","Q170322","Q1520","Q34647","Q956","Q52607","Q1486","Q38545","Q6506","Q1479","Q42810","Q490","Q40269","Q495","Q193241","Q216","Q472","Q585","Q3616","Q7903","Q17151","Q79880","Q158876","Q180717","Q201051","Q374365","Q42635","Q919","Q1781","Q1449","Q185632","Q9361","Q5826","Q109386","Q20934","Q3882","Q9022","Q23430","Q25416","Q189546","Q269","Q33959","Q90","Q52502","Q3624","Q9022","Q192225","Q38511","Q164819"]}